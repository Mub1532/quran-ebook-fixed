@font-face {
    font-family: '{{ font_family }}';
    src: url('../fonts/{{ font_filename }}') format('truetype');
    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: '{{ symbol_font_family }}';
    src: url('../fonts/{{ symbol_font_filename }}') format('truetype');
    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: '{{ basmala_font_family }}';
    src: url('../fonts/{{ basmala_font_filename }}') format('truetype');
    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: '{{ header_label_font_family }}';
    src: url('../fonts/{{ header_label_font_filename }}') format('truetype');
    font-weight: normal;
    font-style: normal;
}

@font-face {
    font-family: '{{ surah_name_font_family }}';
    src: url('../fonts/{{ surah_name_font_filename }}') format('truetype');
    font-weight: normal;
    font-style: normal;
}

/* Global table border reset — e-readers apply default borders to tables */
table, tr, td, th {
    border: none !important;
}

body {
    margin: 0;
    padding: 0;
    text-indent: 0;
    font-family: '{{ font_family }}', 'Scheherazade New', serif;
    font-size: 1.5em;
    color: #1a1a1a;
    background: #fff;
}

/* Plain numbers — use symbol font to bypass KFGQPC digit-as-ayah-marker glyphs */
.plain-num {
    font-family: '{{ symbol_font_family }}', serif;
}

/* === Surah headers === */

table.surah-header {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid #999 !important;
    border-bottom: 1px solid #999 !important;
    /* Top margin so the header doesn't sit flush against the previous
       surah's last line mid-page (matches .surah-name-plain). */
    margin: 0.5em 0 0.3em 0;
}

table.surah-header td {
    padding: 0.15em 0;
    vertical-align: middle;
    border: none;
}

/* Center cell — contains calligraphic glyph + transliteration (bilingual) */
table.surah-header .surah-name {
    text-align: center;
    font-size: 1.5em;
    line-height: 1;
    white-space: nowrap;
    padding: 0.05em 0.3em;
}

/* Calligraphic surah name glyph — ligature font renders ASCII triggers
   (e.g. "surah001surah-icon") as mushaf-style Arabic calligraphy.
   dir="ltr" is set on the HTML element (EPUB CSS forbids direction/unicode-bidi). */
.surah-glyph {
    font-family: '{{ surah_name_font_family }}', serif;
    font-size: 1.4em;
}

/* Plain surah name header — no table, no borders (KFGQPC riwayat). */
.surah-name-plain {
    text-align: center;
    margin: 0.5em 0 0.2em 0;
}

/* Fallback surah name — plain Arabic text in primary font (used when
   calligraphic glyph font is not available for the riwayah). */
.surah-name-text {
    font-family: '{{ font_family }}', serif;
    font-size: 1.3em;
    line-height: 1.2;
}

/* Side columns — surah number + ayah count */
table.surah-header .header-info {
    width: 18%;
    font-family: '{{ header_label_font_family }}', serif;
    font-size: 0.7em;
    color: #555;
    white-space: nowrap;
    text-align: center;
    line-height: 1.3;
    padding: 0 0.3em;
}

/* Latin transliteration + translated meaning below surah glyph (bilingual only) */
.header-transliteration {
    font-family: initial;
    font-size: 0.45em;
    color: #666;
    letter-spacing: 0.03em;
    display: block;
    line-height: 1.2;
    padding-bottom: 0.5em;
}

/* === Bismillah === */

table.bismillah-table {
    width: 100%;
    border-collapse: collapse;
    border: none;
    margin: 0 0 0.15em 0;
}

table.bismillah-table td {
    border: none;
}

.bismillah {
    text-align: center;
    font-family: '{{ basmala_font_family }}', serif;
    font-size: 1.65em;
    line-height: 1;
    padding: 0;
}

/* === Quranic Arabic text === */

/* Ayah-per-line mode (by_surah / ayah_popup / bilingual layouts).
   Alignment is config-driven (layout.ayah_align): right = default
   (device-settled 2026-07-05) | center | justify (justify + text-align-last —
   device-rejected 2026-07-05, CRE stretches lines). Only standalone blocks
   consume this; .bilin below hard-overrides to right regardless. */
.ayah-text {
    font-size: 1em;
    line-height: 1.7;
    {{ ayah_text_align_css }}
    margin: 0;
    break-inside: avoid;
}

/* Arabic-only ayah-per-block: interleaved translations normally separate
   ayah blocks; standalone blocks need the gap themselves or the ragged
   last lines read as arbitrary indentation. text-indent 0 kills the
   reader default first-line paragraph indent (KOReader epub.css) —
   ayah blocks must sit flush right like the .bilin rule does. */
.ayah-text.standalone {
    margin-top: 0.45em;
    text-indent: 0;
    /* Same separator rhythm as translated layouts (there the .translation
       block carries the line) — the line belongs to the ayah unit, not to
       the translation (owner 2026-07-20). */
    padding-bottom: 0.35em;
    border-bottom: 1px solid #eee;
}

/* Inline flowing text mode (inline / interactive layouts) */
.surah-text {
    font-size: 1em;
    line-height: 1.7;
    text-align: justify;
    margin: 0.2em 0 0 0;
}

/* Ayah number markers — KFGQPC renders digits as ornate circle markers.
   inline-block ensures margin is honoured by CREngine and keeps spacing
   immune to text-align:justify stretching. Break control is handled by
   WJ/ZWS in the templates, not by margin asymmetry. */
.ayah-number {
    display: inline-block;
    font-size: 1.2em;
    line-height: 1;
    color: #000;
    margin: 0 0.06em;
}

/* Hizb marker — ornamental rub al-hizb (۞).
   inline-block for the same reason as .ayah-number above. */
.hizb-marker {
    display: inline-block;
    font-family: '{{ hizb_font_family }}', serif;
    font-size: {{ hizb_font_size }};
    vertical-align: middle;
    color: #000;
    margin: 0 0.06em;
}

/* Interactive inline — ayah markers as noteref links (no visual change) */
.ayah-noteref {
    text-decoration: none !important;
    color: inherit;
}

/* ND-26 marker-as-anchor (2026-07-27): non-noteref ayah markers are
   wrapped in a SELF-HREF anchor so the KOReader plugin can intercept
   the tap (its configurable marker popup). Inert everywhere else — a
   self-jump link styled exactly like the plain marker. */
.ayah-mark-link {
    text-decoration: none !important;
    color: inherit;
    /* KOReader/CREngine: never treat the self-href as a footnote link.
       Without this the stock heuristic (link text = a bare number)
       pops the whole ayah block up as a "footnote". (role="doc-link"
       would tell crengine the same thing but is not epubcheck-valid.) */
    -cr-hint: noteref-ignore;
}

/* IndoPak font-built-in ayah marker cluster (NBSP + waqf marks + PUA
   medallion + NBSP, split from the text by the loader). Deliberately a
   PLAIN inline element: display:inline-block was tried (2026-07-05) to
   make the NBSP gaps justification-proof like .ayah-number, but the
   cluster is all bidi-NEUTRALS (NBSP/marks/PUA), so CRE resolves the
   box's internal direction per-content — gaps flipped sides and varied
   by marker type (device-verified BAD). Plain inline keeps the cluster
   in the surrounding RTL run: order correct, gaps symmetric; NBSPs are
   effectively firm in CRE justification in practice. */
.ayah-mark {
}

/* Sajdah overline (IndoPak): the mushaf convention overlines the
   prostration phrase, but the Nastaleeq font doesn't embed overlines, so
   the loader wraps the phrase (span emitted by _wrap_indopak_sajdah) and
   we draw a border-top. inline-block keeps the border continuous across
   the whole phrase; phrases are <= 3 words so the unbreakable box is
   acceptable. Styling contributed by AzIAmDev (issue #15),
   emulator-verified 2026-07-14. */
.sajdah {
    display: inline-block;
    padding-top: 1px;
    line-height: 1.2;
    border-top: 2px solid;
}

/* Footnote reference numbers in translation text */
.noteref {
    font-size: 0.75em;
    vertical-align: super;
    color: #666;
    text-decoration: none;
}

/* === Translation & endnotes === */

/* Bilingual ayah-by-ayah — no wrapper div, styling on elements directly */
.ayah-text.bilin {
    text-align: right;
    text-indent: 0;
    margin-top: 0.5em;
}

/* Ayah-separator hairlines: #eee (reverted to original 2026-07-22 — the
   darker owner-tuned grays #ccc/#ddd/#b0b0b0 all read too heavy in day mode;
   full-width 1px lines look darker than text at the same hex). Trade-off:
   #eee inverts to ~#111 on black, so the line is effectively invisible in
   KOReader night mode — accepted, day-mode subtlety wins. */
.translation {
    padding-bottom: 0.3em;
    border-bottom: 1px solid #eee;
}

/* Translation text — inline (bilingual) */
.translation {
    font-family: initial;
    font-size: {{ translation_font_size }};
    line-height: 1.5;
    color: #333;
    text-align: start;
    margin: 0.2em 0 0 0;
    break-inside: avoid;
}

/* Surah:ayah reference (e.g. "2:255") */
.ayah-ref {
    font-family: initial;
    font-size: 0.85em;
    color: #999;
}

/* Endnote content — translation popups, footnotes, inline footnotes.
   Unified class replacing old .translation-note, .footnote-text, .inline-footnote. */
.endnote {
    font-family: initial;
    font-size: {{ translation_font_size }};
    line-height: 1.5;
    color: #333;
    margin: 0.3em 0;
}

/* === Word-by-Word Interlinear === */

.wbw-ayah {
    text-align: right;
    margin: 0.8em 0 0.2em 0;
    line-height: 1.1;
}

.wbw-word {
    display: inline-table;
    text-align: center;
    margin: 0 0.08em 0.4em 0.08em;
    padding-bottom: 0.2em;
    /* 0.5px keeps the word underline fainter than the 1px ayah separator
       by WEIGHT; #ddd is the original (one notch darker than the #eee
       separators, but the 0.5px weight keeps it lighter overall). */
    border-bottom: 0.5px solid #ddd;
    vertical-align: top;
}

/* WBW translation — slightly more breathing room below than bilingual */
.wbw-ayah + .translation {
    padding-bottom: 0.5em;
}

/* Glosses-only wbw: no .translation block to carry the ayah separator —
   the row itself takes it (template adds .standalone when the ayah has no
   translation). */
.wbw-ayah.standalone {
    padding-bottom: 0.5em;
    border-bottom: 1px solid #eee;
    margin-bottom: 0.6em;
}

/* Hizb marker wrapped in wbw-word for vertical alignment */
.wbw-marker {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}



.wbw-arabic {
    display: table-row;
    font-family: '{{ font_family }}', serif;
    font-size: 1em;
    line-height: 1.8;
}

.wbw-gloss {
    display: table-row;
    font-family: initial;
    font-size: {{ wbw_gloss_font_size }};
    color: #555;
    white-space: nowrap;
    line-height: 1.1;
}

.wbw-translit {
    display: table-row;
    font-family: initial;
    font-size: 0.35em;
    color: #888;
    font-style: italic;
    white-space: nowrap;
    line-height: 1.2;
}

/* Tajweed color rules (QUL resource 87 / alquran.cloud)
   18 rule classes mapped to pedagogical colors */
.tj-ham_wasl, .tj-slnt, .tj-laam_shamsiyah { color: #AAAAAA; }
.tj-madda_normal { color: #537FFF; }
.tj-madda_permissible { color: #4050FF; }
.tj-madda_obligatory_mottasel, .tj-madda_obligatory_monfasel { color: #2144C1; }
.tj-madda_necessary { color: #000EBC; }
.tj-qalaqah { color: #DD0008; }
.tj-ikhafa { color: #9400A8; }
.tj-ikhafa_shafawi { color: #D500B7; }
.tj-idgham_ghunnah { color: #169777; }
.tj-idgham_wo_ghunnah { color: #169200; }
.tj-idgham_shafawi { color: #58B800; }
.tj-idgham_mutajanisayn, .tj-idgham_mutaqaribayn { color: #A1A1A1; }
.tj-iqlab { color: #26BFFD; }
.tj-ghunnah { color: #FF7E1E; }

/* === Fixed 15-line mushaf layout (IndoPak Qudratullah) ==================
   Line breaks come from QUL Mushaf Layout #12, so each .ipk-line holds
   exactly the words the printed 15-line mushaf puts on that line. Pages
   1, 2 and 610 carry 8, 8 and 10 lines — a short page simply ends early
   and the next page starts fresh, which is what page-break-after buys.

   Lines are NOT stretched to both margins. Each .ipk-line is its own
   one-line block, so flush-both-sides would need `text-align-last:
   justify` — tried 2026-09-18 and rejected on the rendered page: the
   printed mushaf reaches its even margins with kashida elongation, which
   CREngine cannot do, so the whole deficit lands in the word gaps and a
   short line tears itself apart. Same ruling the ayah_align note above
   records for .ayah-text. Natural spacing, flush right, ragged left —
   the line BREAKS are what this layout is for. */
.mushaf-page {
    margin: 0;
    padding: 0;
    /* A mushaf page is indivisible: never let the frame tear across two
       reader pages. If the reader's font size makes 15 lines too tall to
       fit, the whole page moves on rather than splitting mid-grid — the
       visible signal to turn the font size down. */
    page-break-inside: avoid;
    break-inside: avoid;
}
.mushaf-page.page-break {
    page-break-after: always;
    -webkit-column-break-after: always;
    break-after: always;
}

/* The frame: a restrained double rule, the way the printed page is
   bordered. Padding is asymmetric-free on purpose — the grid inside
   carries its own rhythm through line-height alone. */
.mushaf-frame {
    border: 1px solid #b9ab8e;
    outline: 3px double #b9ab8e;
    outline-offset: 2px;
    padding: 0.55em 0.7em;
    margin: 0.35em 0.25em 0 0.25em;
}

.ipk-line {
    font-size: 1em;
    line-height: 2.05;
    text-align: right;
    text-indent: 0;
    margin: 0;
    padding: 0;
}

/* Last line of a surah, and any line the layout marks centred (269 of
   them corpus-wide), must NOT be stretched — QUL sets is_centered
   exactly where the printed mushaf centres a short line. */
.ipk-line.ipk-centered {
    text-align: center;
}

/* Surah header as one line of the grid — it occupies a line slot in the
   layout db, so it may not become a multi-line block or the page would
   overflow its 15 slots. */
.ipk-surah {
    text-align: center;
    line-height: 2.05;
}
.ipk-surah-band {
    display: inline-block;
    width: 100%;
    box-sizing: border-box;
    font-family: '{{ font_family }}', serif;
    font-size: 0.82em;
    line-height: 1.5;
    text-align: center;
    color: #000;
    border-top: 1px solid #b9ab8e;
    border-bottom: 1px solid #b9ab8e;
    background: #f3eee2;
    padding: 0.08em 0;
}

.ipk-basmallah {
    text-align: center;
    font-family: '{{ basmala_font_family }}', serif;
    font-size: 0.95em;
    line-height: 2.05;
    margin: 0;
}

/* Folio number under the frame, the mushaf's own page number (1..610) —
   not the reader's, which depends on font size. */
.mushaf-folio {
    text-align: center;
    font-family: '{{ symbol_font_family }}', serif;
    font-size: 0.7em;
    color: #6b6b6b;
    margin: 0.3em 0 0 0;
}


/* === TRUE fixed-layout mushaf (EPUB3 pre-paginated) =====================
   Every box below is in px on the canvas declared per page by a
   viewport meta. Nothing here may depend on the reader's font size — that
   is the whole point of the layout, and it is what separates this from
   the reflowable .ipk-* rules above.

   Per-page values (font-size, block width, line height, frame box, the
   header band and the margin gutter) are emitted inline by the template
   from data/indopak_fxl.page_geometry, so each page is sized to its own
   widest line. */
.fxl-body {
    margin: 0;
    padding: 0;
    width: {{ fxl_page_w }}px;
    height: {{ fxl_page_h }}px;
    position: relative;
}
.fxl-page {
    position: absolute;
    left: 0;
    top: 0;
    width: {{ fxl_page_w }}px;
    height: {{ fxl_page_h }}px;
    overflow: hidden;
}

/* Running head: surah left, para right, the way a 15-line mushaf sets
   it. Floats rather than flex — the widest possible reader support, and
   the two ends never meet at this width. */
.fxl-head {
    position: absolute;
    font-family: '{{ font_family }}', serif;
    font-size: 72px;
    color: #4a4235;
}
.fxl-head-surah { float: left; }
.fxl-head-juz { float: right; }
/* Numerals in the symbol font, same reason as .plain-num above: the
   Quranic Nastaleeq face draws U+0660-0669 far too small to read at
   running-head size (٢ came out ~15px wide against a 52px name). */
.fxl-head-num {
    font-family: '{{ symbol_font_family }}', serif;
}

.fxl-frame {
    position: absolute;
    box-sizing: border-box;
    /* Vertical only — the horizontal inset is applied per LINE so that
       each line's rule reaches both inner edges of the frame. */
    border: 3px solid #b9ab8e;
    outline: 8px double #b9ab8e;
    outline-offset: 7px;
}

/* Here justification DOES fire: the page is sized so this page's widest
   line fills the measure exactly, and the shorter ones stretch to meet
   it. text-align-last is what does the work — each line is its own
   one-line block, so it is always the "last" line.

   The ayah marker's TRAILING nbsp is stripped by the loader when a
   marker ends a line: nbsp neither stretches nor collapses, so it would
   otherwise sit between the medallion and the margin as a fixed gap that
   justification cannot close. */
.fxl-line {
    box-sizing: border-box;   /* the ruled line sits INSIDE the slot */
    text-align: justify;
    text-align-last: justify;
    text-indent: 0;
    margin: 0;
    white-space: nowrap;
}

/* The frame's own bottom rule closes the last line — a border there too
   would read as a double rule. */
.fxl-line.fxl-lastline { border-bottom: none !important; }

/* Deliberately short lines (end of a surah) are centred, never stretched. */
.fxl-line.fxl-centered {
    text-align: center;
    text-align-last: center;
}

/* The surah heading occupies a full line slot of the grid, so its band
   fills that slot completely — no side inset, full height — rather than
   floating as a short strip inside it. */
.fxl-surah {
    text-align: center;
    text-align-last: center;
}
/* Compound selector on purpose: the per-page <style> block sets
   .fxl-line padding and loads AFTER this sheet, so a bare .fxl-surah
   rule of equal specificity would lose and leave the band inset. */
.fxl-line.fxl-surah {
    padding: 0;
}
.fxl-surah-band {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    font-family: '{{ font_family }}', serif;
    /* As large as the slot takes: the body text sits at 1em in this same
       line height, so a heading at 1em is guaranteed to fit too. */
    font-size: 1em;
    text-align: center;
    color: #000;
    border-top: 2px solid #b9ab8e;
    border-bottom: 2px solid #b9ab8e;
    background: #f3eee2;
}

/* A new para opens on a tinted line, as the printed mushaf sets it —
   the same cream family as the surah band but lighter, since it sits
   under running text rather than behind a heading. */
.fxl-line.fxl-juz-start {
    background: #faf6ea;
}

.fxl-basmallah {
    text-align: center;
    text-align-last: center;
    font-family: '{{ basmala_font_family }}', serif;
    font-size: 0.62em;
}

/* Ruku' and sajdah signs live OUTSIDE the gold rule, in the left gutter
   (the end of an RTL line), which is where the printed mushaf sets them
   — and at a size that can actually be read, unlike the font's own
   in-text annotation glyphs. */
/* table/table-cell, not inline: a line carrying BOTH a ruku' close and a
   sajdah needs them STACKED. Side by side they measure ~94px against an
   84px gutter, so the second one wrapped out of the frame entirely
   (caught in the rendered page, 2026-09-18). */
.fxl-mark {
    position: absolute;
    display: table;
    text-align: center;
    font-family: '{{ symbol_font_family }}', serif;
    color: #6b5f4a;
}
.fxl-mark-in {
    display: table-cell;
    vertical-align: middle;
    text-align: center;
    line-height: 1;
}
/* The ruku' sign as the print sets it: a rosette holding the ayn, the
   ruku's number within its surah, and the para it falls in, stacked. */
.fxl-ruku {
    display: block;
    width: 52px;
    margin: 0 auto;
    padding: 5px 0 6px;
    border: 2px solid #b9a980;
    border-radius: 50%;
    text-align: center;
}
.fxl-ruku-ayn {
    display: block;
    font-size: 22px;
    line-height: 1.4;
}
.fxl-ruku-num {
    display: block;
    font-size: 16px;
    line-height: 1.2;
}
.fxl-ruku-juz {
    display: block;
    font-size: 16px;
    line-height: 1.25;
    border-top: 1px solid #c8bb9a;
    width: 22px;
    margin: 0 auto;
}
/* Quarter-hizb and manzil openings. These belong to the line where the
   division BEGINS, unlike the ruku' sign, which marks where one ends. */
/* Sits in an 87px margin, so it wraps at its space rather than bleeding
   off the page edge. No quarter-hizb sign beside it: the print leaves
   that margin empty and marks the rub' under the ayah medallion instead
   (owner, page 7 line 9, 2026-09-20). */
.fxl-manzil {
    display: block;
    width: 80px;
    margin: 4px auto 0;
    font-size: 17px;
    line-height: 1.15;
}
.fxl-sajdah {
    display: block;
    font-size: 24px;
    line-height: 1.1;
    margin-top: 5px;
}

.fxl-folio {
    position: absolute;
    left: 0;
    width: {{ fxl_page_w }}px;
    height: 44px;
    line-height: 44px;
    text-align: center;
    font-family: '{{ symbol_font_family }}', serif;
    font-size: 36px;
    color: #6b6b6b;
}
.fxl-folio-en {
    font-size: 28px;
    color: #8a8a8a;
}

/* Tajweed colour key in the bottom margin, as a printed IndoPak mushaf
   carries it. The rules are split across facing pages so a single strip
   never has to hold all seven. */
.fxl-legend {
    position: absolute;
    text-align: center;
    font-family: '{{ font_family }}', serif;
    font-size: 34px;
    color: #4a4235;
    white-space: nowrap;
}
.fxl-key {
    display: inline-block;
    margin: 0 26px;
    vertical-align: middle;
}
.fxl-dot {
    display: inline-block;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    vertical-align: middle;
    margin-left: 12px;
    border: 1px solid rgba(0,0,0,.18);
}

/* Mark-only tanween colouring (layout.tajweed_tanween: mark).
   Engines paint a lone combining mark with its base letter's colour
   rather than its own, so the mark is never coloured directly: the whole
   cluster is drawn coloured underneath, and an identical black copy with
   the tanween removed sits exactly on top, leaving only the mark showing.

   The wrapper is per WORD. Arabic joins within a word but not across
   spaces, so an inline-block word keeps every cursive join; wrapping a
   single cluster would sever them. The top copy is aria-hidden and
   unselectable so the duplicated text never reaches selection, search or
   a dictionary lookup. */
.tj-ov {
    position: relative;
    display: inline-block;
}
.tj-ov .tj-o {
    position: absolute;
    right: 0;
    top: 0;
    color: #000;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: none;
}

/* --- Tajweed palettes, one per scheme -----------------------------------
   The .tj-* rules further up are the QPC Uthmani scheme: QUL's own 18-rule
   colours, used by configs-tajweed/ (Naskh, full rule set including madd
   and the silent/wasl letters).

   Below is the Qudratullah IndoPak scheme, which is a different publisher
   with a different palette AND a smaller rule set (7 rules; madd and the
   silent letters are left black because IndoPak orthography already
   notates madd). A page opts in by carrying tj-scheme-qudratullah on its
   body, so the two can never bleed into one another. */
.tj-scheme-qudratullah .tj-ikhafa         { color: #438851; }
.tj-scheme-qudratullah .tj-ikhafa_shafawi { color: #C9C856; }
.tj-scheme-qudratullah .tj-qalaqah        { color: #ffc800; }
.tj-scheme-qudratullah .tj-iqlab          { color: #c25cc8; }
.tj-scheme-qudratullah .tj-idgham_ghunnah { color: #ec0f0f; }
.tj-scheme-qudratullah .tj-idgham_shafawi { color: #F3A3B2; }
.tj-scheme-qudratullah .tj-ghunnah        { color: #289FEA; }
